# Type aliases for common return types
CommandResult = Tuple[bool, str, str]  # (success, stdout, stderr)
MaintainResult = Tuple[bool, bool]  # (success, had_changes)
MergeResult = List[int]  # merged_pr_numbers
RepoResult = Tuple[str, bool]  # (status, had_changes); status is a STATUS_* value
TestResult = Tuple[bool, str]  # (success, output)


class WorkingTreeError(Exception):
    """The working tree could not be restored to a known-good state.

    Aborts the repository: the AI's edits are still in place, so continuing
    risks committing them untested on top of whatever comes next.
    """


# Per-repository maintenance outcomes
STATUS_SUCCESS = "success"
STATUS_SKIPPED = "skipped"
STATUS_FAILED = "failed"

# Default values for CLI arguments and configuration
DEFAULT_AGENT_COMMAND = "claude"
DEFAULT_AGENT_FLAGS = "--dangerously-skip-permissions"
DEFAULT_AGENT_TIMEOUT_SECONDS = 300
DEFAULT_CI_TIMEOUT_MINUTES = 10
DEFAULT_DEPENDENCY_MIN_AGE_DAYS = 0
DEFAULT_COMMAND_TIMEOUT_SECONDS = 120
