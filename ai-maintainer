MAX_LOGGED_STAGED_FILES = 20

# A plain version token, the only thing a .ruby-version file may contain.
# Covers "3.2.0", "ruby-3.2.0" and "jruby-9.4.5.0" while excluding whitespace,
# newlines and shell metacharacters.
RUBY_VERSION_RE = re.compile(r"^[A-Za-z0-9._+-]+$")

# Directories a project-local virtualenv is conventionally created in
VENV_DIRS = (".venv", "venv", ".env", "env")

