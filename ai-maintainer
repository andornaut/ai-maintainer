class WorkingTreeError(Exception):
    """The working tree could not be restored to a known-good state.

    Aborts the repository: the AI's edits are still in place, so continuing
    risks committing them untested on top of whatever comes next.
    """


# Per-repository maintenance outcomes
STATUS_SUCCESS = "success"
STATUS_SKIPPED = "skipped"
STATUS_FAILED = "failed"

# Test run outcomes. A repository with no detectable test command reports
# TESTS_NOT_RUN rather than TESTS_PASSED so callers can tell "verified" apart
# from "never checked" and say so before committing.
TESTS_PASSED = "passed"
TESTS_FAILED = "failed"
TESTS_NOT_RUN = "not_run"
# The project declares a test framework whose runner is not installed. Distinct
# from TESTS_NOT_RUN, which callers accept and commit through: this is a broken
# environment, and committing on the strength of it would push code no suite
# ever saw. Distinct from TESTS_FAILED too, because no suite ran, so there is
# nothing for the agent to fix.
TESTS_BLOCKED = "blocked"

