DEFAULT_MAX_FIX_ATTEMPTS = 4

# Other constants
TOOL_REPO_URL = "https://github.com/andornaut/ai-maintainer"

# Canonical form every supported remote URL is normalized to
GITHUB_URL_PREFIX = "https://github.com/"

# Every github.com remote form git accepts: scp-like (git@github.com:o/r),
# https (with or without token userinfo), ssh:// (with or without a port), and
# git://. Anchored on the host so other forges do not match.
GITHUB_REMOTE_RE = re.compile(
    r"^(?:https?://|git://|ssh://)?(?:[^@/]+@)?github\.com(?::\d+)?[:/]"
    r"(?P<owner>[^/]+)/(?P<name>[^/]+?)(?:\.git)?/?$"
)

