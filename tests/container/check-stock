#!/usr/bin/env bash
set -euo pipefail
checkout=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd -- "${checkout}"
# shellcheck source=tests/container/stock
source tests/container/stock
action=${1:-check}
case "${action}" in check|lint|test|build) ;; *) printf 'No %s check declared\n' "${action}" >&2; exit 2 ;; esac
stock_begin "${checkout}"
STOCK_OUTPUT_DIR=
if [[ ${action} == build ]]; then
    stock_run "${PYTHON_IMAGE}" -- sh tests/container/python build
else
    STOCK_NETWORK=bridge stock_run "${PYTHON_IMAGE}" -- sh tests/container/python "${action}"
fi
if [[ ${action} == check || ${action} == lint ]]; then
    STOCK_NETWORK=bridge stock_run "${MARKDOWN_IMAGE}" -- sh tests/container/markdown
    stock_readonly "${SHELLCHECK_IMAGE}" /bin/shellcheck -x -P SCRIPTDIR \
        tests/container/stock tests/container/check-stock \
        tests/container/python tests/container/markdown scripts/test-in-container
fi
stock_finish
